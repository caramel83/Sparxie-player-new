# توكن البوت - تحصل عليه من Discord Developer Portal
DISCORD_TOKEN=ضع_التوكن_هنا

# آيدي تطبيق البوت (Application ID / Client ID)
CLIENT_ID=ضع_الكلايند_آيدي_هنا

# آيدي القناة اللي تبي الألعاب التلقائية تنطلق فيها
# (فعّل وضع المطور بديسكورد، يمين كليك على القناة، Copy Channel ID)
AUTO_GAME_CHANNEL_ID=ضع_آيدي_القناة_هنا

# آيدي قناة الميمات التلقائية (اختياري)
MEME_CHANNEL_ID=ضع_آيدي_القناة_هنا

# آيدي قناة السؤال اليومي (لازم تكون محددة عشان يشتغل /daily التلقائي)
DAILY_CHANNEL_ID=ضع_آيدي_القناة_هنا

# الساعة (بتوقيت UTC، من 0 إلى 23) اللي ينشر/يُحسم فيها السؤال اليومي كل يوم
# افتراضي: 0 (يعني منتصف الليل UTC)
DAILY_HOUR_UTC=0

# قنوات الألعاب اللي يشتغل فيها البريفكس العربي (!رتب، !خمن، إلخ)
# اكتب آيدي قناة واحدة أو أكثر مفصولة بفاصلة بدون فراغات: 111,222,333
# لو تركته فاضي، البريفكس يشتغل بكل القنوات
GAME_CHANNEL_IDS=